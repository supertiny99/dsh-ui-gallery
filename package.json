{
	"name": "@supertiny99/dsh-ui-gallery",
	"version": "0.2.0",
	"description": "DeepSeek Harness 官方组件画廊：在整页面板活体展示 @deepseek-ai/dsh-client-ui-primitives 全部可继承组件与 DSH 窗口盒子模型/112个插槽蓝图——插件 UI 选型的活体文档。external 引宿主冻结模块表，零内嵌依赖。",
	"type": "module",
	"main": "src/host.js",
	"author": "supertiny99",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/supertiny99/dsh-ui-gallery.git"
	},
	"homepage": "https://github.com/supertiny99/dsh-ui-gallery#readme",
	"bugs": {
		"url": "https://github.com/supertiny99/dsh-ui-gallery/issues"
	},
	"exports": {
		".": "./src/host.js",
		"./client": "./dist/client.js",
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-client-runtime"
			]
		}
	},
	"engines": {
		"node": ">=20",
		"dsh": ">=0.2.1-rc.5 <0.3.0"
	},
	"keywords": [
		"dsh",
		"deepseek-harness",
		"dsh-plugin",
		"ui-primitives",
		"gallery",
		"component-catalog"
	],
	"scripts": {
		"build": "node scripts/build.mjs && node scripts/selfcheck.mjs",
		"test": "node scripts/selfcheck.mjs",
		"watch": "node scripts/build.mjs --watch",
		"gen-blueprint": "node scripts/gen-blueprint-data.mjs"
	},
	"devDependencies": {
		"esbuild": "^0.25.10"
	},
	"files": [
		"src",
		"dist/client.js",
		"cordis.patch.yml",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	]
}
